{
  "name": "space-fractions",
  "version": "1.0.0",
  "description": "Web-based, interactive learning tool to improve fraction-solving skills for sixth-grade students.",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
