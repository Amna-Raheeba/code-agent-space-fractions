# Space Fractions service configuration
GAME_PORT=3000
QUESTION_PORT=3001
USER_PORT=3002

# PostgreSQL 14
DATABASE_URL=postgres://spacefractions:spacefractions@localhost:5432/spacefractions

# Redis 6
REDIS_URL=redis://localhost:6379

# RabbitMQ 3
RABBITMQ_URL=amqp://localhost:5672

# Elasticsearch 7
ELASTICSEARCH_URL=http://localhost:9200

# OAuth2
OAUTH2_AUTHORIZATION_ENDPOINT=http://localhost:9000/authorize
OAUTH2_TOKEN_ENDPOINT=http://localhost:9000/token
OAUTH2_INTROSPECTION_ENDPOINT=http://localhost:9000/introspect
OAUTH2_CLIENT_ID=space-fractions
OAUTH2_CLIENT_SECRET=secret
OAUTH2_REDIRECT_URI=http://localhost:3002/oauth/callback
